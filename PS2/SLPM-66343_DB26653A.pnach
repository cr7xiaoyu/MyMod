// 真·三国无双4 帝国 - 1P 专属常驻战神斧（攻击伤害 × 16）
// 2倍：  00108040
// 4倍：  00108080
// 8倍：  001080C0
// 16倍： 00108100
patch=1,EE,201EE9F8,extended,8F828204  // lw   $v0, -0x7DFC($gp) ($v0 = 1P 角色基址)
patch=1,EE,201EE9FC,extended,16220002  // bne  $s1, $v0, 0x001EEA08 (攻击者非1P，跳至战神铠判断)
patch=1,EE,201EEA00,extended,00000000  // nop
patch=1,EE,201EEA04,extended,00108100  // sll  $s0, $s0, 4 (1P 伤害 × 16)

// 真·三国无双4 帝国 - 1P 专属常驻战神铠（所受伤害减半）
// 受伤 1/2 (防御2倍)： 00101043
// 受伤 1/4 (防御4倍)： 00101083
// 受伤 1/8 (防御8倍)： 001010C3
// 受伤 1/16(防御16倍)：00101103
patch=1,EE,201EEA08,extended,8F838204  // lw   $v1, -0x7DFC($gp) ($v1 = 1P 角色基址)
patch=1,EE,201EEA0C,extended,16430002  // bne  $s2, $v1, 0x001EEA18 (受击者非1P，跳出)
patch=1,EE,201EEA10,extended,00000000  // nop
patch=1,EE,201EEA14,extended,00108043  // sra  $s0, $s0, 1 (1P 受伤 ÷ 2)

// 真·三国无双4 帝国 - 1P 专属常驻神速靴（自定义跑速，敌人捡靴子无效）
// 原版神速靴 (20.0f)： 3C0241A0
// 1.5倍神速 (30.0f)：  3C0241F0
// 2.0倍神速 (40.0f)：  3C024220
// 2.5倍神速 (50.0f)：  3C024248
// 3.0倍神速 (60.0f)：  3C024270
patch=1,EE,20190350,extended,8F838204  // lw   $v1, -0x7DFC($gp) ($v1 = 1P 角色基址)
patch=1,EE,20190354,extended,16230010  // bne  $s1, $v1, 0x00190398 (非 1P 角色直接跳走，使用普通速度！)
patch=1,EE,20190358,extended,00000000  // nop  (延迟槽)
patch=1,EE,2019035C,extended,3C024220  // lui  $v0, 0x4220  <-- 跑速浮点高16位替换这里（默认 40.0f）
patch=1,EE,20190360,extended,44822800  // mtc1 $v0, $f5     (将速度写入浮点寄存器 $f5)
patch=1,EE,20190364,extended,10000016  // b    0x001903C0   (跳出，完成速度赋值)
patch=1,EE,20190368,extended,00000000  // nop  (延迟槽)