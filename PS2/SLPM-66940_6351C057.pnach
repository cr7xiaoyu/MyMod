// ============================================================
// PS2《高达无双1》1P专属突破上限与四维倍率强化 (全无延迟槽副作用)
// 原理：仅当 1P(0x10标记位) 攻击或受击时跳过引擎 1000(10倍) 上限封顶，
//       敌方小兵与知名驾驶员完全保持原版攻防上限，不会暴走或变肉。
// ============================================================

// 1. 1P专属解除格斗倍率1000上限
patch=1,EE,201D0610,extended,10000006 // b 0x001D062C
patch=1,EE,201D0618,extended,8D810094 // lw $at, 0x94($t4) (读取攻击方1P标志)
patch=1,EE,201D061C,extended,30210010 // andi $at, $at, 0x0010
patch=1,EE,201D0620,extended,14200002 // bnez $at, 0x001D062C (1P直接跳过封顶)
patch=1,EE,201D0624,extended,286103E8 // slti $at, $v1, 0x03E8 (小兵<1000则$at=1)
patch=1,EE,201D0628,extended,240203E8 // addiu $v0, $zero, 0x03E8
patch=1,EE,201D062C,extended,0041180A // movz $v1, $v0, $at (仅敌将>=1000时封顶为1000)

// 1P格斗攻击倍率 (默认100倍)
// 倍率参考: 20倍=07D0 | 50倍=1388 | 100倍=2710 | 200倍=4E20 | 300倍=7530
// (注: 底层为16位有符号数，最高7FFF约327倍，500倍/1000倍会溢出变负伤害，最高建议用300倍=7530)
patch=1,EE,105D87DC,extended,00002710

// 2. 1P专属解除射击倍率1000上限
patch=1,EE,201D0708,extended,10000006 // b 0x001D0724
patch=1,EE,201D0710,extended,8D810094 // lw $at, 0x94($t4) (读取攻击方1P标志)
patch=1,EE,201D0714,extended,30210010 // andi $at, $at, 0x0010
patch=1,EE,201D0718,extended,14200002 // bnez $at, 0x001D0724 (1P直接跳过封顶)
patch=1,EE,201D071C,extended,286103E8 // slti $at, $v1, 0x03E8
patch=1,EE,201D0720,extended,240203E8 // addiu $v0, $zero, 0x03E8
patch=1,EE,201D0724,extended,0041180A // movz $v1, $v0, $at

// 1P射击攻击倍率 (默认100倍)
// 倍率参考: 20倍=07D0 | 50倍=1388 | 100倍=2710 | 200倍=4E20 | 300倍=7530
patch=1,EE,105D87DE,extended,00002710

// 3. 1P专属解除防御倍率1000上限 (敌人防御不受影响)
patch=1,EE,201D0860,extended,10000006 // b 0x001D087C
patch=1,EE,201D0868,extended,8C810094 // lw $at, 0x94($a0) (读取受击方1P标志)
patch=1,EE,201D086C,extended,30210010 // andi $at, $at, 0x0010
patch=1,EE,201D0870,extended,14200002 // bnez $at, 0x001D087C (1P被打直接跳过防御封顶)
patch=1,EE,201D0874,extended,286103E8 // slti $at, $v1, 0x03E8
patch=1,EE,201D0878,extended,240203E8 // addiu $v0, $zero, 0x03E8
patch=1,EE,201D087C,extended,0041180A // movz $v1, $v0, $at

// 1P防御力倍率 (默认100倍，即仅受1%伤害)
// 倍率参考: 20倍=07D0 | 50倍=1388 | 100倍=2710 | 200倍=4E20 | 300倍=7530
patch=1,EE,105D87E0,extended,00002710